# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/portfolio
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Admin Credentials (change these!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Email Configuration (legacy SMTP - kept for compatibility)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# Resend.com Email (used for contact reply emails - recommended)
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
# The "from" address for outgoing emails (must be from your verified Resend domain)
RESEND_FROM_DOMAIN=noreply@yourdomain.com
# Inbound email address — users reply TO this address, Resend routes it to your webhook
# Set up: Resend dashboard → Domains → Enable Inbound → Add MX records
RESEND_INBOUND_EMAIL=replies@yourdomain.com
# Optional shared secret to verify Resend webhook calls (set in Resend dashboard)
RESEND_WEBHOOK_SECRET=

# LinkedIn API (optional - for follower count)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Cloudinary Configuration (file & image uploads)
# Get your credentials at https://cloudinary.com (Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

